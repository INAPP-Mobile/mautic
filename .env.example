# Mautic on Railway — environment variables
#
# Copy to .env when running locally. On Railway these are set as service
# variables; the deploy form only asks for MAUTIC_ADMIN_PASSWORD (generated).
# Placeholders below are prose, not real values.

# --- mautic service ---
# Admin account seeded on first boot (username admin, email admin@example.com).
MAUTIC_ADMIN_PASSWORD=your-generated-admin-password
# Wired from the mysql companion service (template expressions):
# MAUTIC_DB_HOST=${{mysql.RAILWAY_PRIVATE_DOMAIN}}
# MAUTIC_DB_PASSWORD=${{mysql.MYSQL_PASSWORD}}
# Baked into the image: MAUTIC_DB_PORT=3306, MAUTIC_DB_DATABASE=mautic,
# MAUTIC_DB_USER=mautic, TZ=UTC.

# --- mysql service ---
# MYSQL_ROOT_PASSWORD=${{secret(32)}}
# MYSQL_PASSWORD=${{secret(32)}}
# Baked into the image: MYSQL_DATABASE=mautic, MYSQL_USER=mautic.

# --- optional Mautic tunables (set as service variables if needed) ---
# MAUTIC_MAILER_DSN=                 # e.g. smtp://user:pass@smtp.example.com:587 (sending email)
# MAUTIC_SITE_URL=                  # normally derived at boot from RAILWAY_PUBLIC_DOMAIN
# PHP_INI_VALUE_MEMORY_LIMIT=512M   # image default; raise for large imports
# PHP_INI_VALUE_UPLOAD_MAX_FILESIZE=512M
# PHP_INI_VALUE_MAX_EXECUTION_TIME=300
